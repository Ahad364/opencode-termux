<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_navy</item>
        <item name="colorAccent">@color/brand_purple</item>
        <item name="android:textColorPrimary">@color/brand_text_primary</item>
        <item name="android:textColorSecondary">@color/brand_text_secondary</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:navigationBarColor">@color/brand_navy</item>
    </style>

    <style name="BrandCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="BrandButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BrandButtonSecondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/brand_text_primary</item>
    </style>
</resources>
