<?xml version="1.0" encoding="utf-8"?>
<!-- System input method declaration. settingsActivity lets users jump
     straight from the system "Set up input methods" screen to the app. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.codingkeys.keyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/ime_subtype"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
</input-method>
